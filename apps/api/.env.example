# ==========================================
# ARIOMLANCER - NÚCLEO FINANCEIRO & LEDGER
# ==========================================

# Servidor HTTP / Fastify
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:4200

# Segurança de Sessão BFF & JWT
# Gerar chaves criptográficas de 64 caracteres em produção
JWT_SECRET=axiomlancer_super_secret_enterprise_jwt_key_32chars_min!
COOKIE_SECRET=axiomlancer_enterprise_cookie_signing_secret_998877

# Banco de Dados Relacional PostgreSQL (ACID)
DATABASE_URL="postgresql://axiom_user:axiom_pass@localhost:5432/axiomlancer_finance?schema=public"

# Redis para Orquestração Assíncrona & BullMQ (Régua de Cobrança)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
