datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ToneOfVoice {
  AMIGAVEL
  FIRME
  EXECUTIVO
}

enum ChannelType {
  EMAIL
  SMS
  WHATSAPP
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  email            String            @unique
  name             String
  billing_paused   Boolean           @default(false)
  current_score    Decimal           @default(0.00) @db.Decimal(12, 2)
  created_at       DateTime          @default(now()) @db.Timestamptz
  updated_at       DateTime?         @updated_at @db.Timestamptz
  deleted_at       DateTime?         @db.Timestamptz

  templates        MessageTemplate[]
  feedbacks        ProjectFeedback[]
  cycles           CycleEvaluation[]
  expenses         ProfessionalExpenses[]
  projects         Project[]
  contracts        Contract[]

  @@map("users")
}

model MessageTemplate {
  id            String       @id @default(uuid()) @db.Uuid
  user_id       String       @db.Uuid
  tone_of_voice ToneOfVoice
  channel       ChannelType
  subject       String?      @db.VarChar(255)
  body          String       @db.Text
  created_at    DateTime     @default(now()) @db.Timestamptz
  updated_at    DateTime?    @updated_at @db.Timestamptz
  deleted_at    DateTime?    @db.Timestamptz

  user          User         @relation(fields: [user_id], references: [id], onDelete: Restrict)
  project       Project      @relation(fields: [project_id], references: [id], onDelete: Restrict)

  @@index([user_id], map: "idx_message_template_user")
  @@map("message_template")
}

model ProjectFeedback {
  id            String       @id @default(uuid()) @db.Uuid
  user_id       String       @db.Uuid
  project_id    String       @unique @db.Uuid
  score         Decimal      @db.Decimal(12, 2)
  comments      String?      @db.Text
  created_at    DateTime     @default(now()) @db.Timestamptz
  updated_at    DateTime?    @updated_at @db.Timestamptz

  user          User         @relation(fields: [user_id], references: [id], onDelete: Restrict)
  project       Project      @relation(fields: [project_id], references: [id], onDelete: Restrict)

  @@index([user_id], map: "idx_project_feedback_user")
  @@map("project_feedback")
}

enum CycleTriggerType {
  MILESTONE_10_PROJECTS
  MONTHLY_30_DAYS
  MANUAL
}

enum CycleEvaluationStatus {
  PENDING
  COMPLETED
  EXPIRED
}

model CycleEvaluation {
  id                    String                @id @default(uuid()) @db.Uuid
  user_id               String                @db.Uuid
  client_id             String                @db.Uuid
  cycle_identifier      String                @unique @db.VarChar(150)
  score_communication   Decimal?              @db.Decimal(12, 2)
  score_proactivity     Decimal?              @db.Decimal(12, 2)
  score_results         Decimal?              @db.Decimal(12, 2)
  score_understanding   Decimal?              @db.Decimal(12, 2)
  score_demand_delivery Decimal?              @db.Decimal(12, 2)
  general_score         Decimal               @db.Decimal(12, 2)
  comments              String?               @db.Text
  trigger_type          CycleTriggerType      @default(MANUAL)
  status                CycleEvaluationStatus @default(PENDING)
  invitation_token      String?               @unique @db.VarChar(255)
  invitation_sent_at    DateTime?             @db.Timestamptz
  completed_at          DateTime?             @db.Timestamptz
  client_name           String?               @db.VarChar(255)
  created_at            DateTime              @default(now()) @db.Timestamptz
  updated_at            DateTime?             @updated_at @db.Timestamptz

  user                  User                  @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id], map: "idx_cycle_evaluation_user")
  @@index([invitation_token], map: "idx_cycle_evaluation_token")
  @@map("cycle_evaluation")
}

enum ExpenseCategory {
  INFRA
  SAAS
  CONTABILIDADE
  EQUIPAMENTO
  IMPOSTOS
  OUTROS
}

enum ExpenseStatus {
  PENDING
  PAID
  CANCELED
}

model ProfessionalExpenses {
  id          String          @id @default(uuid()) @db.Uuid
  user_id     String          @db.Uuid
  description String          @db.VarChar(255)
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  due_date    DateTime?       @db.Date
  paid_at     DateTime?       @db.Timestamptz
  status      ExpenseStatus   @default(PENDING)
  is_fixed    Boolean         @default(false)
  created_at  DateTime        @default(now()) @db.Timestamptz
  updated_at  DateTime?       @updated_at @db.Timestamptz
  deleted_at  DateTime?       @db.Timestamptz

  user        User            @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id, status], map: "idx_professional_expenses_user_status")
  @@map("professional_expenses")
}

model Project {
  id                    String           @id @default(uuid()) @db.Uuid
  user_id               String           @db.Uuid
  client_id             String           @db.Uuid
  name                  String           @db.VarChar(255)
  description           String?          @db.Text
  start_date            DateTime         @db.Date
  end_date              DateTime?        @db.Date
  is_public_client_name Boolean          @default(false)
  created_at            DateTime         @default(now()) @db.Timestamptz
  updated_at            DateTime?        @updated_at @db.Timestamptz
  deleted_at            DateTime?        @db.Timestamptz

  user                  User             @relation(fields: [user_id], references: [id], onDelete: Restrict)
  feedback              ProjectFeedback?

  @@index([user_id], map: "idx_project_user")
  @@index([client_id], map: "idx_project_client")
  @@map("project")
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELED
  PENDING_SIGNATURE
}

model Contract {
  id             String          @id @default(uuid()) @db.Uuid
  user_id        String          @db.Uuid
  client_id      String          @db.Uuid
  title          String          @db.VarChar(255)
  description    String?         @db.Text
  contract_value Decimal         @db.Decimal(12, 2)
  status         ContractStatus  @default(PENDING_SIGNATURE)
  start_date     DateTime        @db.Date
  end_date       DateTime?       @db.Date
  terms_clause   String?         @db.Text
  accepted_at    DateTime?       @db.Timestamptz
  signer_name    String?         @db.VarChar(255)
  signer_email   String?         @db.VarChar(255)
  signer_ip      String?         @db.VarChar(50)
  signature_hash String?         @db.VarChar(255)
  created_at     DateTime        @default(now()) @db.Timestamptz
  updated_at     DateTime?       @updated_at @db.Timestamptz
  deleted_at     DateTime?       @db.Timestamptz

  user           User            @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id], map: "idx_contract_user")
  @@index([client_id], map: "idx_contract_client")
  @@map("contract")
}