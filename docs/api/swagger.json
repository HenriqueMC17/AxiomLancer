{
  "openapi": "3.0.3",
  "info": {
    "title": "AxiomLancer SaaS - Core Financial & Contract API",
    "version": "1.0.0",
    "description": "API RESTful corporativa para gestao financeira autonoma, templates de cobranca e formalizacao juridica de contratos com aceite digital imutavel."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Servidor Local / V1"
    },
    {
      "url": "http://localhost:3000/api",
      "description": "Servidor Local / Standard"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "axiom_session",
        "description": "JWT assinado transmitido exclusivamente via cookie HttpOnly (Zero Trust)."
      }
    },
    "schemas": {
      "ToneOfVoice": {
        "type": "string",
        "enum": [
          "AMIGAVEL",
          "FIRME",
          "EXECUTIVO"
        ]
      },
      "ChannelType": {
        "type": "string",
        "enum": [
          "EMAIL",
          "SMS",
          "WHATSAPP"
        ]
      },
      "MessageTemplate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "tmpl_1730419200"
          },
          "user_id": {
            "type": "string",
            "example": "usr_7keys_001"
          },
          "tone_of_voice": {
            "$ref": "#/components/schemas/ToneOfVoice"
          },
          "channel": {
            "$ref": "#/components/schemas/ChannelType"
          },
          "subject": {
            "type": "string",
            "example": "Lembrete amigavel: Fatura {{invoice_number}} vence em breve"
          },
          "body": {
            "type": "string",
            "example": "Ola {{client_name}}, sua fatura no valor de {{gross_value}} vence em {{due_date}}."
          }
        },
        "required": [
          "id",
          "user_id",
          "tone_of_voice",
          "channel",
          "subject",
          "body"
        ]
      },
      "CreateTemplateRequest": {
        "type": "object",
        "required": [
          "tone_of_voice",
          "channel",
          "subject",
          "body"
        ],
        "properties": {
          "tone_of_voice": {
            "$ref": "#/components/schemas/ToneOfVoice"
          },
          "channel": {
            "$ref": "#/components/schemas/ChannelType"
          },
          "subject": {
            "type": "string",
            "minLength": 3,
            "example": "Lembrete: Fatura {{invoice_number}}"
          },
          "body": {
            "type": "string",
            "minLength": 10,
            "example": "Ola {{client_name}}, a sua fatura {{invoice_number}} esta disponivel. Chave PIX: {{pix_key}}"
          }
        }
      },
      "UpdateTemplateRequest": {
        "type": "object",
        "properties": {
          "tone_of_voice": {
            "$ref": "#/components/schemas/ToneOfVoice"
          },
          "channel": {
            "$ref": "#/components/schemas/ChannelType"
          },
          "subject": {
            "type": "string",
            "minLength": 3
          },
          "body": {
            "type": "string",
            "minLength": 10
          }
        }
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "example": "Dados do template invalidos"
          },
          "context": {
            "type": "object"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ContractStatus": {
        "type": "string",
        "enum": [
          "PENDING_SIGNATURE",
          "ACTIVE",
          "COMPLETED",
          "CANCELED"
        ],
        "example": "PENDING_SIGNATURE"
      },
      "Contract": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "cnt_01"
          },
          "user_id": {
            "type": "string",
            "example": "usr_7keys_001"
          },
          "client_id": {
            "type": "string",
            "example": "cli_acme"
          },
          "client_name": {
            "type": "string",
            "example": "Acme Corp Dev Lab"
          },
          "title": {
            "type": "string",
            "example": "Desenvolvimento de Motor de Cobranca Autonoma"
          },
          "description": {
            "type": "string",
            "example": "Construcao de esteira deterministica com split tributario."
          },
          "contract_value": {
            "type": "number",
            "format": "double",
            "example": 24500
          },
          "status": {
            "$ref": "#/components/schemas/ContractStatus"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "example": "2026-01-10"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "example": "2026-06-30"
          },
          "terms_clause": {
            "type": "string",
            "example": "Clausula 1: Entregas validadas quinzenalmente..."
          },
          "accepted_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2026-01-10T11:30:00Z"
          },
          "signer_name": {
            "type": "string",
            "nullable": true,
            "example": "Carlos Eduardo Menezes"
          },
          "signer_email": {
            "type": "string",
            "format": "email",
            "nullable": true,
            "example": "carlos@acmedev.io"
          },
          "signer_ip": {
            "type": "string",
            "nullable": true,
            "example": "187.54.12.98"
          },
          "signature_hash": {
            "type": "string",
            "nullable": true,
            "example": "sha256_e49b81f9a0c213e8_acme_2026"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "user_id",
          "client_id",
          "title",
          "contract_value",
          "status",
          "start_date",
          "terms_clause",
          "created_at"
        ]
      },
      "CreateContractRequest": {
        "type": "object",
        "required": [
          "client_id",
          "title",
          "contract_value",
          "start_date",
          "terms_clause"
        ],
        "properties": {
          "client_id": {
            "type": "string",
            "example": "cli_acme"
          },
          "title": {
            "type": "string",
            "example": "Contrato de Engenharia de Software"
          },
          "description": {
            "type": "string",
            "example": "Desenvolvimento de APIs e microsservicos resilientes"
          },
          "contract_value": {
            "type": "number",
            "example": 18000,
            "description": "Valor monetario calculado com precisao decimal.js Decimal(12,2)"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "example": "2026-03-01"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "example": "2026-08-31"
          },
          "terms_clause": {
            "type": "string",
            "example": "Clausula 1: Entregas em 3 etapas com smart escrow..."
          }
        }
      },
      "UpdateContractRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Contrato de Engenharia de Software (Revisado)"
          },
          "description": {
            "type": "string"
          },
          "contract_value": {
            "type": "number",
            "example": 20000
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "terms_clause": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ContractStatus"
          }
        }
      },
      "AcceptContractRequest": {
        "type": "object",
        "required": [
          "signer_name",
          "signer_email",
          "confirm_terms"
        ],
        "properties": {
          "signer_name": {
            "type": "string",
            "example": "Carlos Eduardo Menezes"
          },
          "signer_email": {
            "type": "string",
            "format": "email",
            "example": "carlos@acmedev.io"
          },
          "confirm_terms": {
            "type": "boolean",
            "enum": [
              true
            ],
            "example": true,
            "description": "Concordancia juridica expressa com os termos e valores pactuados"
          }
        }
      },
      "CycleTriggerType": {
        "type": "string",
        "enum": [
          "MILESTONE_10_PROJECTS",
          "MONTHLY_30_DAYS",
          "MANUAL"
        ],
        "example": "MILESTONE_10_PROJECTS"
      },
      "CycleEvaluationStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "COMPLETED",
          "EXPIRED"
        ],
        "example": "COMPLETED"
      },
      "CycleEvaluation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "cyc_1730592000000_a1b2"
          },
          "user_id": {
            "type": "string",
            "example": "usr_7keys_001"
          },
          "client_id": {
            "type": "string",
            "example": "cli_acme"
          },
          "cycle_identifier": {
            "type": "string",
            "example": "cycle_m10_cli_acme_2026-11"
          },
          "trigger_type": {
            "$ref": "#/components/schemas/CycleTriggerType"
          },
          "status": {
            "$ref": "#/components/schemas/CycleEvaluationStatus"
          },
          "score_communication": {
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "example": 5
          },
          "score_proactivity": {
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "example": 4.8
          },
          "score_results": {
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "example": 5
          },
          "score_understanding": {
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "example": 4.9
          },
          "score_demand_delivery": {
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "example": 5
          },
          "general_score": {
            "type": "number",
            "example": 4.94
          },
          "comments": {
            "type": "string",
            "example": "Desempenho excepcional de nivel Staff Engineer."
          },
          "invitation_token": {
            "type": "string",
            "example": "tkn_mvzyqdrb_vy50fv_dlprwmwt"
          },
          "invitation_sent_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "client_name": {
            "type": "string",
            "example": "Acme Corporation"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TriggerCycleEvaluationRequest": {
        "type": "object",
        "required": [
          "client_id",
          "trigger_type"
        ],
        "properties": {
          "client_id": {
            "type": "string",
            "example": "cli_acme"
          },
          "trigger_type": {
            "$ref": "#/components/schemas/CycleTriggerType"
          }
        }
      },
      "SubmitCycleFeedbackRequest": {
        "type": "object",
        "required": [
          "score_communication",
          "score_proactivity",
          "score_results",
          "score_understanding",
          "score_demand_delivery",
          "comments"
        ],
        "properties": {
          "score_communication": {
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "example": 5
          },
          "score_proactivity": {
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "example": 4.5
          },
          "score_results": {
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "example": 5
          },
          "score_understanding": {
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "example": 4.8
          },
          "score_demand_delivery": {
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "example": 5
          },
          "comments": {
            "type": "string",
            "minLength": 15,
            "maxLength": 2000,
            "example": "Excelente comunicacao, entregas pontuais e alto entendimento do negocio."
          }
        }
      }
    }
  },
  "security": [
    {
      "cookieAuth": []
    }
  ],
  "paths": {
    "/message-templates": {
      "get": {
        "summary": "Lista todos os templates do usuario autenticado",
        "responses": {
          "200": {
            "description": "Lista de templates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "templates": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MessageTemplate"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Nao autorizado ou sessao invalida"
          }
        }
      },
      "post": {
        "summary": "Cria um novo template de mensagem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTemplateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Template criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "template": {
                      "$ref": "#/components/schemas/MessageTemplate"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Erro de validacao (Fail Fast Zod)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Nao autorizado"
          }
        }
      }
    },
    "/message-templates/{id}": {
      "put": {
        "summary": "Atualiza template existente",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTemplateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Template atualizado"
          },
          "404": {
            "description": "Template nao encontrado ou acesso nao autorizado"
          }
        }
      },
      "delete": {
        "summary": "Remove template existente",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Removido com sucesso"
          },
          "404": {
            "description": "Template nao encontrado ou acesso nao autorizado"
          }
        }
      }
    },
    "/contracts": {
      "get": {
        "summary": "Lista todos os contratos do freelancer autenticado (Zero Trust)",
        "responses": {
          "200": {
            "description": "Lista de contratos vinculados ao usuario",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "contracts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Contract"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Nao autorizado ou sessao ausente"
          }
        }
      },
      "post": {
        "summary": "Emite novo contrato de prestacao de servicos com validacao estrita Zod e decimal.js",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateContractRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contrato emitido em estado PENDING_SIGNATURE",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "contract": {
                      "$ref": "#/components/schemas/Contract"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Erro de validacao temporal ou monetaria (Fail Fast Zod)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Nao autorizado"
          }
        }
      }
    },
    "/contracts/{id}": {
      "put": {
        "summary": "Atualiza termos de um contrato em minuta (PENDING_SIGNATURE)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identificador UUID do contrato"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateContractRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contrato atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "contract": {
                      "$ref": "#/components/schemas/Contract"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Violacao de regra de negocio (contrato ja assinado e imutavel)"
          },
          "404": {
            "description": "Contrato nao encontrado"
          }
        }
      },
      "delete": {
        "summary": "Remove contrato em minuta (apenas PENDING_SIGNATURE)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contrato removido com sucesso"
          },
          "400": {
            "description": "Impossivel remover contrato ativo/assinado"
          },
          "404": {
            "description": "Contrato nao encontrado"
          }
        }
      }
    },
    "/contracts/{id}/accept": {
      "post": {
        "summary": "Registra o aceite digital imutavel do contrato gerando carimbo de data/hora e hash SHA-256",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptContractRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Aceite digital formalizado e contrato transicionado para ACTIVE",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Contrato aceito digitalmente com sucesso."
                    },
                    "contract": {
                      "$ref": "#/components/schemas/Contract"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Contrato ja assinado ou dados de confirmacao invalidos"
          },
          "404": {
            "description": "Contrato nao encontrado"
          }
        }
      }
    },
    "/cycle-evaluations": {
      "get": {
        "summary": "Lista todas as avaliacoes de ciclo do freelancer autenticado (Zero Trust)",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de avaliacoes de ciclo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CycleEvaluation"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Nao autenticado (ausencia de cookie axiom_session)"
          }
        }
      }
    },
    "/cycle-evaluations/trigger": {
      "post": {
        "summary": "Dispara manualmente uma avaliacao de ciclo para um cliente especifico",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TriggerCycleEvaluationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ciclo criado com status PENDING e convite disparado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/CycleEvaluation"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Ciclo ja disparado (conflito de idempotencia) ou dados invalidos"
          }
        }
      }
    },
    "/cycle-evaluations/{token}": {
      "get": {
        "summary": "Rota publica: busca informacoes basicas do ciclo para preenchimento pelo cliente",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Metadados do ciclo pendente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "cycle_identifier": {
                          "type": "string"
                        },
                        "trigger_type": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "client_id": {
                          "type": "string"
                        },
                        "invitation_sent_at": {
                          "type": "string"
                        },
                        "completed_at": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
