{
  "openapi": "3.0.3",
  "info": {
    "title": "AxiomLancer SaaS - Core Financial, Legal & Compliance API",
    "version": "1.0.0",
    "description": "API RESTful corporativa para gestao financeira autonoma, faturamento preditivo, conciliacao bancaria PIX e formalizacao juridica de contratos com aceite digital imutavel."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Servidor Canonico / V1"
    },
    {
      "url": "http://localhost:3000/api",
      "description": "Servidor Standard / Legado"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "axiom_session",
        "description": "JWT assinado transmitido exclusivamente via cookie HttpOnly (Zero Trust / BFF Pattern)."
      }
    },
    "schemas": {
      "ToneOfVoice": {
        "type": "string",
        "enum": [
          "AMIGAVEL",
          "FIRME",
          "EXECUTIVO"
        ]
      },
      "ChannelType": {
        "type": "string",
        "enum": [
          "EMAIL",
          "SMS",
          "WHATSAPP"
        ]
      },
      "InvoiceStatus": {
        "type": "string",
        "enum": [
          "DRAFT",
          "PENDING",
          "PAID",
          "OVERDUE",
          "CANCELED"
        ]
      },
      "ContractStatus": {
        "type": "string",
        "enum": [
          "ACTIVE",
          "COMPLETED",
          "CANCELED",
          "PENDING_SIGNATURE"
        ]
      },
      "ExpenseCategory": {
        "type": "string",
        "enum": [
          "INFRA",
          "SAAS",
          "CONTABILIDADE",
          "EQUIPAMENTO",
          "IMPOSTOS",
          "OUTROS"
        ]
      },
      "CycleTriggerType": {
        "type": "string",
        "enum": [
          "MILESTONE_10_PROJECTS",
          "MONTHLY_30_DAYS",
          "MANUAL"
        ]
      },
      "CycleEvaluationStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "COMPLETED",
          "EXPIRED"
        ]
      },
      "StandardError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "example": "Os dados enviados sao invalidos"
          },
          "context": {
            "type": "object"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "security": [
    {
      "cookieAuth": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Autenticacao corporativa com emissao de cookie HttpOnly",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 6
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticacao realizada com sucesso"
          },
          "401": {
            "description": "Credenciais invalidas"
          },
          "429": {
            "description": "Rate limit excedido"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Encerramento seguro de sessao",
        "responses": {
          "200": {
            "description": "Cookie revogado com sucesso"
          }
        }
      }
    },
    "/dashboard/summary": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Sumarizacao financeira de caixa, OPEX e margem liquida real (decimal.js)",
        "responses": {
          "200": {
            "description": "Resumo financeiro consolidado"
          }
        }
      }
    },
    "/clients": {
      "get": {
        "tags": [
          "Clients"
        ],
        "summary": "Lista clientes cadastrados do usuario autenticado (Zero Trust)",
        "responses": {
          "200": {
            "description": "Lista de clientes"
          }
        }
      },
      "post": {
        "tags": [
          "Clients"
        ],
        "summary": "Cadastra novo cliente corporativo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "legal_name",
                  "email",
                  "tone_of_voice"
                ],
                "properties": {
                  "legal_name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "tone_of_voice": {
                    "$ref": "#/components/schemas/ToneOfVoice"
                  },
                  "billing_paused": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cliente cadastrado com sucesso"
          }
        }
      }
    },
    "/clients/{id}": {
      "put": {
        "tags": [
          "Clients"
        ],
        "summary": "Atualiza cadastro de cliente",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cliente atualizado"
          },
          "404": {
            "description": "Cliente nao encontrado"
          }
        }
      },
      "delete": {
        "tags": [
          "Clients"
        ],
        "summary": "Remove cliente",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cliente removido com sucesso"
          }
        }
      }
    },
    "/invoices": {
      "get": {
        "tags": [
          "Invoices"
        ],
        "summary": "Lista faturas emitidas pelo usuario",
        "responses": {
          "200": {
            "description": "Faturas do usuario"
          }
        }
      },
      "post": {
        "tags": [
          "Invoices"
        ],
        "summary": "Emite nova fatura com provisao automatica de DAS (Fator R)",
        "responses": {
          "201": {
            "description": "Fatura emitida com sucesso"
          }
        }
      }
    },
    "/invoices/{id}/recover": {
      "post": {
        "tags": [
          "Invoices"
        ],
        "summary": "Recupera fatura inadimplente aplicando retencao de 5% de Success Fee",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fatura liquidada com retencao de take rate"
          }
        }
      }
    },
    "/contracts": {
      "get": {
        "tags": [
          "Contracts"
        ],
        "summary": "Lista todos os contratos do freelancer",
        "responses": {
          "200": {
            "description": "Lista de contratos"
          }
        }
      },
      "post": {
        "tags": [
          "Contracts"
        ],
        "summary": "Emite novo contrato com clausulas e termos de aceite",
        "responses": {
          "201": {
            "description": "Contrato emitido em minuta"
          }
        }
      }
    },
    "/contracts/{id}": {
      "put": {
        "tags": [
          "Contracts"
        ],
        "summary": "Atualiza minuta de contrato pendente",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contrato atualizado"
          }
        }
      },
      "delete": {
        "tags": [
          "Contracts"
        ],
        "summary": "Remove contrato em minuta",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contrato removido"
          }
        }
      }
    },
    "/contracts/{id}/accept": {
      "post": {
        "tags": [
          "Contracts"
        ],
        "summary": "Aceite digital formal com registro de IP e hash criptografico de nao-repudio",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contrato aceito digitalmente e ativado"
          }
        }
      }
    },
    "/cycle-evaluations": {
      "get": {
        "tags": [
          "CycleEvaluations"
        ],
        "summary": "Lista avaliacoes de ciclo recorrente (10 projetos / 30 dias)",
        "responses": {
          "200": {
            "description": "Lista de avaliacoes"
          }
        }
      }
    },
    "/cycle-evaluations/trigger": {
      "post": {
        "tags": [
          "CycleEvaluations"
        ],
        "summary": "Dispara avaliacao de ciclo para cliente ativo",
        "responses": {
          "201": {
            "description": "Convite de avaliacao emitido"
          }
        }
      }
    },
    "/cycle-evaluations/{token}": {
      "get": {
        "tags": [
          "CycleEvaluations"
        ],
        "summary": "Consulta publica do convite de avaliacao via token seguro",
        "security": [],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dados do convite para preenchimento"
          }
        }
      },
      "post": {
        "tags": [
          "CycleEvaluations"
        ],
        "summary": "Submissao publica de notas de 5 dimensoes qualitativas",
        "security": [],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Feedback computado e score recalculado"
          }
        }
      }
    },
    "/expenses": {
      "get": {
        "tags": [
          "Expenses"
        ],
        "summary": "Lista despesas operacionais do usuario",
        "responses": {
          "200": {
            "description": "Lista de despesas"
          }
        }
      },
      "post": {
        "tags": [
          "Expenses"
        ],
        "summary": "Cadastra nova despesa operacional (OPEX)",
        "responses": {
          "201": {
            "description": "Despesa registrada com sucesso"
          }
        }
      }
    },
    "/expenses/{id}": {
      "put": {
        "tags": [
          "Expenses"
        ],
        "summary": "Atualiza dados de despesa",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Despesa atualizada"
          }
        }
      },
      "delete": {
        "tags": [
          "Expenses"
        ],
        "summary": "Remove despesa",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Despesa removida"
          }
        }
      }
    },
    "/projects": {
      "get": {
        "tags": [
          "Projects"
        ],
        "summary": "Lista portfolio de projetos com mascaramento LGPD",
        "responses": {
          "200": {
            "description": "Projetos do portfolio"
          }
        }
      },
      "post": {
        "tags": [
          "Projects"
        ],
        "summary": "Cadastra novo projeto no portfolio",
        "responses": {
          "201": {
            "description": "Projeto cadastrado com sucesso"
          }
        }
      }
    },
    "/projects/{id}": {
      "put": {
        "tags": [
          "Projects"
        ],
        "summary": "Atualiza informacoes do projeto",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projeto atualizado"
          }
        }
      },
      "delete": {
        "tags": [
          "Projects"
        ],
        "summary": "Remove projeto do portfolio",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Projeto removido"
          }
        }
      }
    },
    "/feedbacks": {
      "post": {
        "tags": [
          "Feedbacks"
        ],
        "summary": "Submete feedback pontual de projeto com recalculo assincrono em background",
        "responses": {
          "201": {
            "description": "Feedback gravado e job enfileirado"
          }
        }
      }
    },
    "/panic-button": {
      "get": {
        "tags": [
          "PanicButton"
        ],
        "summary": "Consulta estado do Safe Mode (< 12ms)",
        "responses": {
          "200": {
            "description": "Estado do circuito de seguranca"
          }
        }
      },
      "post": {
        "tags": [
          "PanicButton"
        ],
        "summary": "Alterna pausa emergencial de cobranca com latencia sub-12ms",
        "responses": {
          "200": {
            "description": "Circuito alterado com telemetria"
          }
        }
      }
    },
    "/profile": {
      "get": {
        "tags": [
          "Profile"
        ],
        "summary": "Obtem perfil do usuario autenticado (Zero Trust)",
        "responses": {
          "200": {
            "description": "Perfil do usuario"
          }
        }
      },
      "post": {
        "tags": [
          "Profile"
        ],
        "summary": "Atualiza informacoes cadastrais do usuario autenticado",
        "responses": {
          "200": {
            "description": "Perfil atualizado com sucesso"
          }
        }
      }
    },
    "/profile/score": {
      "get": {
        "tags": [
          "Profile"
        ],
        "summary": "Consulta score ponderado de reputacao do freelancer",
        "responses": {
          "200": {
            "description": "Score de reputacao detalhado"
          }
        }
      }
    },
    "/dre": {
      "get": {
        "tags": [
          "FinancialBI"
        ],
        "summary": "Demonstrativo de Resultado do Exercicio (DRE) com margem EBITDA",
        "responses": {
          "200": {
            "description": "DRE calculado via decimal.js"
          }
        }
      }
    },
    "/pricing": {
      "post": {
        "tags": [
          "FinancialBI"
        ],
        "summary": "Calculadora de precificacao ideal por hora e projeto com provisao tributaria",
        "responses": {
          "200": {
            "description": "Analise de precificacao minima e ideal"
          }
        }
      }
    },
    "/predictive-cashflow": {
      "get": {
        "tags": [
          "FinancialBI"
        ],
        "summary": "Fluxo de caixa preditivo projetado para 30, 60 e 90 dias",
        "responses": {
          "200": {
            "description": "Projecao preditiva de liquidez"
          }
        }
      }
    },
    "/message-templates": {
      "get": {
        "tags": [
          "MessageTemplates"
        ],
        "summary": "Lista templates de cobranca customizados",
        "responses": {
          "200": {
            "description": "Templates disponiveis"
          }
        }
      },
      "post": {
        "tags": [
          "MessageTemplates"
        ],
        "summary": "Cria template de mensagem multicanal",
        "responses": {
          "201": {
            "description": "Template criado com sucesso"
          }
        }
      }
    },
    "/message-templates/{id}": {
      "put": {
        "tags": [
          "MessageTemplates"
        ],
        "summary": "Atualiza template existente",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Template atualizado"
          }
        }
      },
      "delete": {
        "tags": [
          "MessageTemplates"
        ],
        "summary": "Remove template",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Template removido"
          }
        }
      }
    }
  }
}