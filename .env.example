# ==============================================================================
# AxiomLancer - Environment Configuration Template
# Clean Architecture | Zero Trust | Fail Fast | 7Keys Standards
# ==============================================================================

# -- 1. Seguranca e Autenticacao (JWT BFF) -------------------------------------
# Chave mestra para assinatura de tokens JWT (HS256). Minimo de 32 caracteres.
# Em producao, gere uma chave criptograficamente segura: openssl rand -hex 32
JWT_SECRET=your-32-character-or-longer-jwt-secret-key-2026

# Tempo de expiracao da sessao (ex: 2h, 24h, 7d). Padrao: 2h
JWT_EXPIRES_IN=2h

# URL base publica da aplicacao (usada para convites, webhooks e callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -- 2. Credenciais Administrativas de Demonstracao (Seed / Admin) ------------
# Usuario mestre para autenticacao e isolamento de tenant (Zero Secrets)
ADMIN_EMAIL=henrique@7keys.dev
ADMIN_PASSWORD=change-this-in-production
ADMIN_NAME=Henrique Monteiro
ADMIN_USER_ID=usr_7keys_001

# -- 3. Convex Serverless (Database Reativo e Estado Global - Opcional) --------
# Credenciais e endpoint do cluster Convex (quando ativo)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=
